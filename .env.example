# ==========================================
# NetRwandaFilms Environment Variables
# ==========================================

# Database: Supabase PostgreSQL
# 1. Connection Pooling (port 6543) for Next.js runtime queries:
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Direct Connection (port 5432) for Prisma migrations & schema pushes:
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Authentication: NextAuth.js
# Generate a secret via: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="f8a7e3b1c9d2e4a6f7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0"

# Cloudflare R2 / Backblaze B2 (S3-Compatible Object Storage for HLS Videos and Posters)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="netrwanda-media"
R2_PUBLIC_DOMAIN="https://media.netrwanda.com"

# Initial Admin & Editor Accounts (used by prisma/seed.ts)
DEFAULT_ADMIN_EMAIL="admin@netrwanda.com"
DEFAULT_ADMIN_PASSWORD="AdminRwanda2025!Secure"
DEFAULT_EDITOR_EMAIL="editor@netrwanda.com"
DEFAULT_EDITOR_PASSWORD="EditorRwanda2025!Secure"

